<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tesseract.Drawing\Tesseract.Drawing.csproj" />
    <ProjectReference Include="..\Tesseract\Tesseract.csproj" />
    <!-- AnyUnit instead of nunit/NUnit3TestAdapter/Microsoft.NET.Test.Sdk - no
         Tesseract.Native package reference needed here (unlike the
         Tesseract.Tests.AnyUnit spike this replaces): this project already gets
         its native binaries from the repo's own stage/&lt;rid&gt;/native convention,
         via GlobalTestSetup's LibraryLoader.CustomSearchPath override. -->
    <ProjectReference Include="..\..\..\..\..\AnyUnit\AnyUnit\AnyUnit.csproj" />
    <ProjectReference Include="..\..\..\..\..\AnyUnit\Contrib\AnyUnit.Style.Nunit\AnyUnit.Style.Nunit.csproj" />
    <ProjectReference Include="..\..\..\..\..\AnyUnit\AnyUnit.Runner.Bootstrap\AnyUnit.Runner.Bootstrap.csproj" />
  </ItemGroup>

  <!--
    Data/, Results/, and tessdata/ live directly under this project (no more
    Link-based indirection from a separate NetCore31Tests project, since
    this is the one test project now). Wildcarded rather than listed file
    by file: a new fixture/data file just needs to be dropped in, no
    csproj edit required.
  -->
  <ItemGroup>
    <None Include="Data\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Results\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tessdata\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The {82a7f48d-...} <Service> marker (identifies this project as a VSTest
       test project to `dotnet test`/Visual Studio) is gone along with
       Microsoft.NET.Test.Sdk - this is a plain console app now, run directly
       (see Program.cs), not through the VSTest test host. -->
</Project>
