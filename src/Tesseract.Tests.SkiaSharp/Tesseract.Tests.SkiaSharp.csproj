<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Equivalent test coverage to Tesseract.Tests's ConvertBitmapToPixTests/ColorTests, but for
    Tesseract.CrossPlatform.SkiaSharp instead of Tesseract.Drawing: a separate project (not
    added into Tesseract.Tests itself) so SkiaSharp stays a dependency only of the tests that
    actually exercise it. Runs on every desktop RID this repo targets (unlike
    ConvertBitmapToPixTests, which is Windows-only because System.Drawing.Common is).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Starts warning-clean (confirmed via a real build): see
         Tesseract.CrossPlatform.SkiaSharp.csproj's own comment for why this
         is safe alongside vendor/tesseract's own warning-heavy Tesseract.csproj. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- AnyUnit instead of nunit/NUnit3TestAdapter/Microsoft.NET.Test.Sdk - see
         Tesseract.Tests.csproj's own identical swap for the full reasoning.
         Real 1.0.0 release from nuget.org now, not a local checkout. -->
    <PackageReference Include="AnyUnit" Version="1.0.0" />
    <PackageReference Include="AnyUnit.Style.Nunit" Version="1.0.0" />
    <PackageReference Include="AnyUnit.Runner.Bootstrap" Version="1.0.0" />
  </ItemGroup>

  <!--
    The direct Tesseract.csproj reference here must build under the same
    AssemblyName=Tesseract.CrossPlatform override Tesseract.CrossPlatform.SkiaSharp's
    own Tesseract.csproj reference uses (see that project's own comment for why):
    otherwise MSBuild builds Tesseract.csproj *twice* in this graph, under two
    different assembly identities ("Tesseract" from this direct reference,
    "Tesseract.CrossPlatform" transitively via the other), and this project's own
    Pix/PixColor/etc. usage wouldn't type-match what Tesseract.CrossPlatform.SkiaSharp's
    methods actually expect.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Tesseract.CrossPlatform.SkiaSharp\Tesseract.CrossPlatform.SkiaSharp.csproj" />
    <ProjectReference Include="..\Tesseract\Tesseract.csproj" AdditionalProperties="AssemblyName=Tesseract.CrossPlatform" />
  </ItemGroup>

  <!--
    Just the two fixture files these tests actually need, pulled from Tesseract.Tests's own
    Data/ instead of duplicating a second copy of the whole fixture set: one 32bpp RGB(A) PNG
    and one 8bpp grayscale PNG, matching the two pixel layouts this package supports.
  -->
  <ItemGroup>
    <None Include="..\Tesseract.Tests\Data\Binarization\neo-32bit.png" Link="Data\Binarization\neo-32bit.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Tesseract.Tests\Data\Binarization\neo-8bit-grayscale.png" Link="Data\Binarization\neo-8bit-grayscale.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The {82a7f48d-...} <Service> marker (VSTest test-project identity) is gone
       along with Microsoft.NET.Test.Sdk - plain console app now, run directly. -->
</Project>
