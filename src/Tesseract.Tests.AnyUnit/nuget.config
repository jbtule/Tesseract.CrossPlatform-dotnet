<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Tesseract.Native.* isn't on nuget.org - reuse whatever's already
         extracted in the local global-packages cache (built/restored by
         this repo's own build-native/pack flow previously), same idea as
         smoketest/SmokeTest.csproj's own local-feed pattern, just pointed
         at the cache directly instead of a throwaway temp feed. -->
    <add key="local-global-cache" value="/Users/jay/.nuget/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
