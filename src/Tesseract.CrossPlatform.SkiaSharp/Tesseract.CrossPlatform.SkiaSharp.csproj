<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SkiaSharp-based equivalent of Tesseract.Drawing (System.Drawing.Common), scoped down to
    just enough to cover the same gap image codecs leave under browser-wasm: converting
    already-decoded pixels (SKBitmap, which SkiaSharp, unlike System.Drawing.Common, can
    decode/encode on every RID this repo targets, wasm included via
    SkiaSharp.NativeAssets.WebAssembly below) to/from Pix, without this package or
    Tesseract.CrossPlatform itself needing to link in an image codec. The
    SkiaSharp.NativeAssets.WebAssembly reference is a no-op for every desktop RID: its
    targets are internally conditioned on '$(RuntimeIdentifier)' == 'browser-wasm', the
    standard pattern for a shared library that wants to support a wasm consumer without
    forcing one on every consumer; see the WASM backlog plan's Phase 3 (Pix.FromRawPixelData)
    for the eventual wasm-side story past this converter.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Tesseract.CrossPlatform.SkiaSharp</PackageId>
    <Authors>jay@tuley.name</Authors>
    <Company />
    <Product>Tesseract.CrossPlatform.SkiaSharp</Product>
    <Description>SkiaSharp-based Pix/SKBitmap interop for Tesseract.CrossPlatform -- a cross-platform (browser-wasm included) alternative to Tesseract.Drawing's System.Drawing.Common-based (Windows-only) converters.</Description>
    <Copyright>Copyright 2019-2020 Charles Weld; 2026 Jay Tuley</Copyright>
    <PackageProjectUrl>https://github.com/jbtule/tesseract-nuget-platforms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jbtule/tesseract-nuget-platforms</RepositoryUrl>
    <PackageTags>Tesseract Ocr SkiaSharp</PackageTags>
    <!--
      Tracks the same PACKAGE_VERSION as Tesseract.CrossPlatform/Tesseract.Native
      (see versions.env's own comment for the <tesseract-pin>.<packaging-major*100+minor>
      scheme): a deliberate choice, one version number across every package in a
      release, bumped together, rather than an independent semver for this package.
      This hardcoded value is the local-dev default for a bare `dotnet pack`; real
      packing (scripts/smoketest-wasm.sh, release.yml once this package joins that
      pipeline) passes -p:Version=$PACKAGE_VERSION explicitly and overrides it. Keep
      this in sync by hand when versions.env's PACKAGE_VERSION changes.
    -->
    <Version>5.5.2.2</Version>
    <AssemblyVersion>5.5.2.2</AssemblyVersion>
    <NeutralLanguage></NeutralLanguage>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RootNamespace>Tesseract</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.152.0" />
  </ItemGroup>

  <!--
    PrivateAssets="all": a plain ProjectReference to Tesseract.csproj here
    packs as a nuspec dependency on package id "Tesseract" (that project's
    own default PackageId, from its assembly name) at whatever $(Version)
    this pack run happens to carry: a real bug, found via an actual
    `dotnet pack` + restore, not assumed. It resolves against the real,
    unrelated "Tesseract" package on nuget.org (charlesw's own, not this
    fork's "Tesseract.CrossPlatform"), which obviously never has a matching
    version. This package is only ever meaningful installed alongside a
    real Tesseract.CrossPlatform (see this project's own Description).
    PrivateAssets="all" still compiles this project against the real
    Tesseract.dll normally, it just stops NuGet from emitting that broken
    dependency to consumers, who reference Tesseract.CrossPlatform
    themselves anyway.

    AdditionalProperties="AssemblyName=Tesseract.CrossPlatform": a second,
    separate real bug, also found via an actual pack + restore + real
    consumer build (scripts/smoketest-wasm.sh), not assumed. Without this,
    Tesseract.csproj compiles here under its own default assembly name
    ("Tesseract"), so this project's IL ends up referencing types like
    Pix from assembly identity "Tesseract", but the actually-published,
    installed Tesseract.CrossPlatform package ships an assembly literally
    named "Tesseract.CrossPlatform" (see nuget/wrapper's own
    -p:AssemblyName=Tesseract.CrossPlatform build step; needed there to
    avoid a case-insensitive-filesystem filename collision with the
    generic native "tesseract" alias). Different assembly name = different
    strong identity even with identical types/namespace, so a consumer
    installing both real packages together got CS0012 ("type 'Pix' is
    defined in an assembly that is not referenced"). Building this
    reference under the *same* renamed identity real consumers actually
    have makes this project's compiled output match reality.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Tesseract\Tesseract.csproj" PrivateAssets="all"
                       AdditionalProperties="AssemblyName=Tesseract.CrossPlatform" />
  </ItemGroup>

</Project>
